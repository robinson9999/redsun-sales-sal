// Cloudflare Worker: ứng dụng Quy chế Lương thưởng & KPI
// - main: máy chủ (đăng nhập, phân quyền, API)
// - assets: giao diện trong public/, chỉ phục vụ sau khi đăng nhập (run_worker_first)
// - d1_databases: cơ sở dữ liệu D1, Cloudflare tự tạo ở lần deploy đầu
// - r2_buckets: kho file R2 (proposal PDF), Cloudflare tự tạo ở lần deploy đầu
{
  "name": "redsun-quy-che",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Mọi yêu cầu qua máy chủ (đăng nhập) – trừ thư viện/ font/ ảnh dùng cho trang proposal gửi khách:
    // các file này không có thông tin nội bộ, Cloudflare phục vụ thẳng từ điểm gần người xem (nhanh hơn nhiều)
    "run_worker_first": ["/*", "!/proposal/_shared/*", "!/vendor/pdfjs/*", "!/proposal/*/assets/*"]
  },
  // Chạy máy chủ gần cơ sở dữ liệu D1 để các truy vấn liên tiếp nhanh hơn
  "placement": { "mode": "smart" },
  "d1_databases": [
    { "binding": "DB", "database_name": "redsun-quy-che-db" }
  ],
  // r2_buckets: kho lưu file PDF của proposal tải lên (Cloudflare tự tạo bucket ở lần deploy đầu)
  "r2_buckets": [
    { "binding": "FILES" }
  ],
  "observability": { "enabled": true },
  // Giữ các biến/secret đặt trên Dashboard (vd SETTINGS_KEY) khi deploy từ GitHub
  "keep_vars": true
}
